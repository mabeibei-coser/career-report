# 生产环境变量模板。真实值写到 .env.production.local（不进版本库）
# 复制到服务器：cp deploy/.env.production.example .env.production.local && vim .env.production.local

# DeepSeek / AI 模型（主模型）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# BananaRouter Gemini（测评主模型、报告 fallback）
BANANAROUTER_API_KEY=your_bananarouter_api_key_here
BANANAROUTER_BASE_URL=https://api.bananarouter.com
BANANAROUTER_MODEL=gemini-3.1-flash-lite

# Node / Next.js 运行端口（pm2 和 nginx 反代都会用到）
PORT=3000
NODE_ENV=production
